# Server-only configuration. Never use NEXT_PUBLIC_ for an API credential.
API_ENDPOINT=https://your-sid-service.example
API_KEY=replace-with-your-existing-api-key

# Required for npm run start / any production deployment. Use HTTPS when hosted.
# This password protects the demo, and is NOT your Manni API key.
DEMO_ACCESS_USERNAME=manni
DEMO_ACCESS_PASSWORD=
